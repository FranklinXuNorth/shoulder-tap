# 拷成同目录下的 .env。这个文件只待在你自己机器上，不进仓库、不上传任何地方。

# 你的 Notion integration secret。哨兵拿它去查你今天的清单。
NOTION_TOKEN=

# 部署地址。用官方那台就不用改。
SHOULDER_TAP_URL=https://shoulder-tap.vercel.app/mcp

# 服务端设了门禁才需要填。
SHOULDER_TAP_KEY=

# 本机直接请求 Jev 做首轮比较，不经过 Vercel。未配置时由对话模型判断。
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# 设为 0 暂停本机 Jev。请求超时 2 秒后自动退回模型判断。
SHOULDER_TAP_LOCAL_JEV=1


# 跨机器。中转地址是你自己部署的 Cloudflare Worker（worker/ 目录，npx wrangler deploy 会打印出来）。
# 设备令牌由 node install.mjs 登录时自动写入，不用手填。
SHOULDER_TAP_RELAY=
SHOULDER_TAP_DEVICE_TOKEN=
# 设为 0 就不上报使用统计（几台机器、几块屏、手势类型）。跨机器照常能用。
SHOULDER_TAP_TELEMETRY=1
