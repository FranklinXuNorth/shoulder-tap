# 拷成同目录下的 .env。这个文件只待在你自己机器上，不进仓库、不上传任何地方。
# 一般不用手动改：设置页（node onboard.mjs，或托盘里的「设置…」）会替你写。

# 选了用 Notion 存数据才需要：你的 Notion integration 密钥。这台机器直接拿它连你自己的 Notion。
NOTION_TOKEN=

# 可选：本机直接请求 Jev 做首轮「相不相关」的比较。不填就由对话模型自己判。
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# 设为 0 暂停本机 Jev。请求超时 2 秒后自动退回模型判断。
SHOULDER_TAP_LOCAL_JEV=1

# 跨机器同步（只对本地存储生效，见 docs/sync.md）。每台机器填同一把密钥；
# 第一台生成一把：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SHOULDER_TAP_SYNC_URL=https://shoulder-tap-sync.<你的子域>.sync.example
# SHOULDER_TAP_SYNC_KEY=
# 这台机器身边没人（比如服务器上接 Discord 的 OpenClaw）：时区用同步过来的你的时区，不用服务器的
# SHOULDER_TAP_HEADLESS=1
