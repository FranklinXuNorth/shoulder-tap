<Window x:Class="ShoulderTap.TapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="shoulder-tap"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual" SizeToContent="Manual"
        Focusable="False" IsHitTestVisible="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#181818" />
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="3*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="7*" />
    </Grid.RowDefinitions>
    <!-- NES-style pixel box: two ink bars make the notched outline, two paper bars fill it.
         One "pixel" is 2 DIP = 3 physical px at 150%. -->
    <Grid x:Name="CaptionBox" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
          Opacity="0" Visibility="Collapsed" MaxWidth="440" Margin="0,0,300,0"
          SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Rectangle Fill="{StaticResource Ink}" Margin="2,0" />
      <Rectangle Fill="{StaticResource Ink}" Margin="0,2" />
      <Rectangle Fill="{StaticResource Bg}" Margin="4,6" />
      <Rectangle Fill="{StaticResource Bg}" Margin="6,4" />
      <!-- Fusion Pixel draws on a 12px grid; 16 DIP x 150% = 24px keeps every glyph pixel whole. -->
      <TextBlock x:Name="CaptionText" Foreground="{StaticResource Ink}" Margin="14,9,14,10"
                 FontFamily="pack://application:,,,/Fonts/#Fusion Pixel 12px Prop zh_hans" FontSize="16"
                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" />
    </Grid>
    <!-- Same white-glove pixel style; tap keeps its pointing index, completion keeps its raised palm. -->
    <Image x:Name="PixelHand" Grid.Row="1" Width="288" Height="240"
           HorizontalAlignment="Right" Visibility="Collapsed" Stretch="Fill"
           RenderOptions.BitmapScalingMode="NearestNeighbor" />
  </Grid>
</Window>
