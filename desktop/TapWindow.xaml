<Window x:Class="ShoulderTap.TapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="shoulder-tap"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual" SizeToContent="Manual"
        Focusable="False" IsHitTestVisible="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#181818" />
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
    </Grid.RowDefinitions>
    <Border x:Name="CaptionBox" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
            Opacity="0" Visibility="Collapsed" MaxWidth="440" Margin="0,0,300,0"
            Background="{StaticResource Bg}" BorderBrush="{StaticResource Ink}" BorderThickness="2"
            CornerRadius="6" Padding="12,7,12,8">
      <TextBlock x:Name="CaptionText" Foreground="{StaticResource Ink}" FontSize="14"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="66" />
    </Border>
    <!-- Same white-glove pixel style; tap keeps its pointing index, completion keeps its raised palm. -->
    <Image x:Name="PixelHand" Grid.Row="1" Width="288" Height="240"
           HorizontalAlignment="Right" Visibility="Collapsed" Stretch="Fill"
           RenderOptions.BitmapScalingMode="NearestNeighbor" />
  </Grid>
</Window>
