<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 只为了托盘图标 NotifyIcon；WPF 自己没有托盘。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 自己写 Main，需要 Mutex 在 Application 之前就位，所以不要 App.xaml。 -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shoulder-tap-tap</AssemblyName>
    <RootNamespace>ShoulderTap</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WFO0003：WinForms 要求 DPI 走它的项目属性，但这里是 WPF 窗口，只能靠清单。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置的 glove 皮肤。其它皮肤从 ~/.claude/skills/shoulder-tap/ui/sprites/skins/<名字>/ 按文件读。 -->
    <Resource Include="..\skill\shoulder-tap\ui\sprites\skins\glove\tap.png" Link="tap.png" />
    <Resource Include="..\skill\shoulder-tap\ui\sprites\skins\glove\pat.png" Link="pat.png" />
    <Resource Include="..\skill\shoulder-tap\ui\sprites\skins\glove\snap.png" Link="snap.png" />
    <Resource Include="Fonts\fusion-pixel-12px-proportional-zh_hans.ttf" />
    <EmbeddedResource Include="..\skill\shoulder-tap\ui\sprites\tap-glove.png" Link="tap-glove.png" />
  </ItemGroup>

</Project>
